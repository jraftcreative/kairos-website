---
const base = import.meta.env.BASE_URL
---

<section class="bg-white">
  <div class="mx-auto max-w-7xl px-6 md:px-12 py-12">
    <!-- Mobile: Stacked layout with full-width buttons -->
    <div class="lg:hidden">
      <img 
        src="https://images.unsplash.com/photo-1560520653-9e0e4c89eb11?q=80&w=1973&auto=format&fit=crop"
        alt="Professional financial consultation"
        loading="lazy"
        decoding="async"
        class="w-full h-56 object-cover rounded-xl"
      />
      
      <div class="mt-8">
        <h3 class="text-2xl font-medium text-base-900 text-balance">
          Partner with us for your financial success
        </h3>
        
        <p class="text-base text-base-500 mt-4">
          The Kairos Advisory Group network is an exclusive association of distinguished financial advisers. 
          Our team is ready to guide you on your journey to financial security.
        </p>
        
        <!-- Mobile: Full-width stacked buttons with larger touch targets -->
        <div class="flex flex-col gap-3 mt-8">
          <a 
            href={`${base}contact/`}
            class="flex items-center justify-center gap-3 px-8 py-5 bg-base-900 text-white font-medium hover:bg-base-800 active:bg-base-950 rounded-xl transition-colors duration-200"
          >
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" />
            </svg>
            Contact Us
          </a>
          <a 
            href={`${base}team/`}
            class="flex items-center justify-center gap-3 px-8 py-5 border border-base-200 text-base-900 font-medium hover:bg-base-50 active:bg-base-100 rounded-xl transition-colors duration-200"
          >
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z" />
            </svg>
            Meet Our Team
          </a>
        </div>
      </div>
    </div>
    
    <!-- Desktop: Side-by-side layout (original) -->
    <div class="hidden lg:grid relative md:grid-cols-2 gap-4 items-center">
      <!-- Image -->
      <img 
        src="https://images.unsplash.com/photo-1560520653-9e0e4c89eb11?q=80&w=1973&auto=format&fit=crop"
        alt="Professional financial consultation"
        loading="lazy"
        decoding="async"
        class="h-64 md:h-[60vh] w-full object-cover"
      />
      
      <!-- Content -->
      <div class="p-8 lg:p-16 h-full flex flex-col items-center justify-center border border-base-200">
        <div>
          <h3 class="text-2xl sm:text-3xl lg:text-4xl font-medium text-base-900 text-balance">
            Partner with us for your financial success
          </h3>
          
          <div class="mt-8 pt-8 border-t border-base-200">
            <p class="text-base text-base-500">
              The Kairos Advisory Group network is an exclusive association of distinguished financial advisers. 
              Our team is ready to guide you on your journey to financial security and success.
            </p>
          </div>
          
          <div class="flex flex-wrap gap-4 mt-8">
            <a 
              href={`${base}contact/`}
              class="inline-flex items-center justify-center px-8 py-4 bg-base-900 text-white font-medium hover:bg-base-800 transition-colors duration-200"
            >
              Contact Us
            </a>
            <a 
              href={`${base}team/`}
              class="inline-flex items-center justify-center px-8 py-4 border border-base-200 text-base-900 font-medium hover:bg-base-50 transition-colors duration-200"
            >
              Meet Our Team
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
