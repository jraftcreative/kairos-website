---
const base = import.meta.env.BASE_URL
---

<section class="overflow-hidden">
  <div class="mx-auto max-w-7xl px-6 md:px-12 pb-12">
    <!-- Hero Image -->
    <div class="relative bg-base-100">
      <img 
        src={`${base}Melta_kiro%20Edited_Header%20(2).jpg`}
        alt="Kairos Advisory Group"
        loading="eager"
        decoding="async"
        class="w-full h-[40vh] md:h-[50vh] lg:h-[60vh] 2xl:h-[70vh] object-contain"
      />
    </div>
    
    <!-- Headline -->
    <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-medium tracking-tight text-base-900 mt-8 md:mt-12 text-balance max-w-4xl">
      Financial Planning Made Simple.
    </h1>
    
    <!-- Mobile: Quick stats/trust indicators -->
    <div class="lg:hidden grid grid-cols-3 gap-4 mt-8 pt-8 border-t border-base-200">
      <div class="text-center">
        <div class="text-2xl font-semibold text-base-900">15+</div>
        <div class="text-xs text-base-500 mt-1">Years Experience</div>
      </div>
      <div class="text-center">
        <div class="text-2xl font-semibold text-base-900">500+</div>
        <div class="text-xs text-base-500 mt-1">Clients Served</div>
      </div>
      <div class="text-center">
        <div class="text-2xl font-semibold text-base-900">$50M+</div>
        <div class="text-xs text-base-500 mt-1">Assets Managed</div>
      </div>
    </div>
  </div>
</section>
