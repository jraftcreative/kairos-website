---
// Hero Section Component
---

<section class="overflow-hidden">
  <div class="mx-auto max-w-7xl px-6 md:px-12 pb-12">
    <!-- Hero Image -->
    <div class="relative">
      <img 
        src="https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?q=80&w=2070&auto=format&fit=crop"
        alt="Modern financial district skyline"
        loading="eager"
        decoding="async"
        class="w-full h-[50vh] lg:h-[60vh] 2xl:h-[70vh] object-cover"
      />
      
      <!-- Contact Card Overlay -->
      <div class="absolute bottom-0 right-0 bg-white p-6 md:p-8 max-w-xs">
        <h3 class="text-sm font-medium text-base-900">Kairos Advisory Group</h3>
        <a href="tel:+6565118888" class="text-sm text-base-500 hover:text-base-900 transition-colors mt-1 block">
          Tel: +65 6511 8888
        </a>
      </div>
    </div>
    
    <!-- Headline -->
    <h1 class="text-4xl sm:text-5xl lg:text-6xl font-medium tracking-tight text-base-900 mt-12 text-balance max-w-4xl">
      Financial Planning Made Simple.
    </h1>
  </div>
</section>
