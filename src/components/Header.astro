---
const base = import.meta.env.BASE_URL

const navigation = [
  { name: 'About Us', href: `${base}about/` },
  { name: 'Our Approach', href: `${base}approach/` },
  { name: 'Services', href: `${base}services/` },
  { name: 'Our Team', href: `${base}team/` },
  { name: 'Career', href: `${base}career/` },
  { name: 'Contact', href: `${base}contact/` },
]

const currentPath = Astro.url.pathname
---

<header class="w-full">
  <div class="mx-auto max-w-7xl px-6 md:px-12 py-6">
    <div class="flex items-center justify-between">
      <!-- Logo -->
      <a href={base} class="flex items-center">
        <img 
          src={`${base}Kairos%20Logo%20Option%20%20_Option%202%20B.png`}
          alt="Kairos Advisory Group"
          class="h-16 sm:h-20 md:h-24 w-auto"
        />
      </a>
      
      <!-- Desktop Navigation -->
      <nav class="hidden lg:flex items-center gap-8">
        {navigation.map((item) => (
          <a 
            href={item.href} 
            class:list={[
              'text-sm font-medium transition-colors duration-200',
              currentPath.includes(item.href.replace(base, '').replace('/', ''))
                ? 'text-base-900'
                : 'text-base-500 hover:text-base-900'
            ]}
          >
            {item.name}
          </a>
        ))}
      </nav>
      
      <!-- CTA Button - Desktop Only -->
      <div class="hidden lg:flex items-center gap-4">
        <a 
          href={`${base}contact/`}
          class="px-6 py-2.5 bg-base-900 text-white text-sm font-medium hover:bg-base-800 transition-colors duration-200"
        >
          Contact Us
        </a>
      </div>
      
      <!-- Mobile: Quick action buttons instead of hamburger -->
      <div class="lg:hidden flex items-center gap-2">
        <a 
          href="tel:+6512345678"
          class="p-3 text-base-600 hover:text-base-900 hover:bg-base-100 rounded-full transition-colors"
          aria-label="Call us"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
          </svg>
        </a>
        <a 
          href="https://wa.me/6512345678"
          class="p-3 text-base-600 hover:text-base-900 hover:bg-base-100 rounded-full transition-colors"
          aria-label="WhatsApp"
          target="_blank"
          rel="noopener"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</header>
