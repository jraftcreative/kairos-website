---
const navigation = [
  { name: 'About Us', href: '/about' },
  { name: 'Our Approach', href: '/approach' },
  { name: 'Services', href: '/services' },
  { name: 'Our Team', href: '/team' },
  { name: 'Career', href: '/career' },
  { name: 'Contact', href: '/contact' },
]

const currentPath = Astro.url.pathname
---

<header class="w-full">
  <div class="mx-auto max-w-7xl px-6 md:px-12 py-6">
    <div class="flex items-center justify-between">
      <!-- Logo -->
      <a href="/" class="flex items-center">
        <svg class="h-8 text-base-900" viewBox="0 0 120 30" fill="none" xmlns="http://www.w3.org/2000/svg">
          <text x="0" y="24" font-family="system-ui, -apple-system, sans-serif" font-size="24" font-weight="700" letter-spacing="0.1em" fill="currentColor">
            KAIROS
          </text>
        </svg>
      </a>
      
      <!-- Desktop Navigation -->
      <nav class="hidden lg:flex items-center gap-8">
        {navigation.map((item) => (
          <a 
            href={item.href} 
            class:list={[
              'text-sm font-medium transition-colors duration-200',
              currentPath === item.href || currentPath.startsWith(item.href + '/')
                ? 'text-base-900'
                : 'text-base-500 hover:text-base-900'
            ]}
          >
            {item.name}
          </a>
        ))}
      </nav>
      
      <!-- CTA Button -->
      <div class="hidden lg:flex items-center gap-4">
        <a 
          href="/contact" 
          class="px-6 py-2.5 bg-base-900 text-white text-sm font-medium hover:bg-base-800 transition-colors duration-200"
        >
          Contact Us
        </a>
      </div>
      
      <!-- Mobile Menu Button -->
      <button 
        id="mobile-menu-button"
        type="button" 
        class="lg:hidden p-2 text-base-600 hover:text-base-900"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="sr-only">Open main menu</span>
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
        </svg>
      </button>
    </div>
    
    <!-- Mobile Menu -->
    <nav 
      id="mobile-menu" 
      class="lg:hidden hidden overflow-hidden transition-all duration-300"
    >
      <div class="pt-8 pb-4 border-t border-base-200 mt-6 space-y-4">
        {navigation.map((item) => (
          <a 
            href={item.href} 
            class:list={[
              'block py-2 text-base font-medium transition-colors duration-200',
              currentPath === item.href || currentPath.startsWith(item.href + '/')
                ? 'text-base-900'
                : 'text-base-500 hover:text-base-900'
            ]}
          >
            {item.name}
          </a>
        ))}
        <a 
          href="/contact" 
          class="block w-full text-center px-6 py-3 bg-base-900 text-white text-sm font-medium hover:bg-base-800 transition-colors duration-200 mt-6"
        >
          Contact Us
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  const menuButton = document.getElementById('mobile-menu-button')
  const mobileMenu = document.getElementById('mobile-menu')
  
  menuButton?.addEventListener('click', () => {
    const isExpanded = menuButton.getAttribute('aria-expanded') === 'true'
    menuButton.setAttribute('aria-expanded', (!isExpanded).toString())
    mobileMenu?.classList.toggle('hidden')
  })
</script>
