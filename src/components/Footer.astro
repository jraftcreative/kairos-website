---
const footerNavigation = {
  navigation: [
    { name: 'About Us', href: '/about' },
    { name: 'Our Approach', href: '/approach' },
    { name: 'Services', href: '/services' },
    { name: 'Our Team', href: '/team' },
    { name: 'Career', href: '/career' },
    { name: 'Contact Us', href: '/contact' },
  ],
  legal: [
    { name: 'FAQ', href: '/faq' },
    { name: 'Terms', href: '/terms' },
    { name: 'Privacy', href: '/privacy' },
  ],
  services: [
    { name: 'Financial Planning', href: '/services/financial-planning' },
    { name: 'Insurance Selection', href: '/services/insurance-selection' },
    { name: 'Investment Methodologies', href: '/services/investment-methodologies' },
    { name: 'Business Solutions', href: '/services/business-solutions' },
  ],
}

const currentYear = new Date().getFullYear()
---

<footer class="bg-white border-t border-base-200">
  <div class="mx-auto max-w-7xl px-6 md:px-12 py-16">
    <!-- Logo -->
    <div class="flex justify-center mb-12">
      <svg class="h-16 text-base-900" viewBox="0 0 300 40" fill="none" xmlns="http://www.w3.org/2000/svg">
        <text x="50%" y="32" text-anchor="middle" font-family="system-ui, -apple-system, sans-serif" font-size="36" font-weight="700" letter-spacing="0.15em" fill="currentColor">
          KAIROS
        </text>
      </svg>
    </div>
    
    <!-- Navigation Grid -->
    <div class="grid grid-cols-2 md:grid-cols-3 gap-8 pt-8 border-t border-base-200">
      <!-- Navigation -->
      <div>
        <h3 class="text-base font-medium text-base-900">Navigation</h3>
        <ul class="mt-6 space-y-3">
          {footerNavigation.navigation.map((item) => (
            <li>
              <a href={item.href} class="text-base-500 hover:text-base-900 transition-colors duration-200">
                {item.name}
              </a>
            </li>
          ))}
        </ul>
      </div>
      
      <!-- Legal -->
      <div>
        <h3 class="text-base font-medium text-base-900">Legal</h3>
        <ul class="mt-6 space-y-3">
          {footerNavigation.legal.map((item) => (
            <li>
              <a href={item.href} class="text-base-500 hover:text-base-900 transition-colors duration-200">
                {item.name}
              </a>
            </li>
          ))}
        </ul>
      </div>
      
      <!-- Services -->
      <div>
        <h3 class="text-base font-medium text-base-900">Services</h3>
        <ul class="mt-6 space-y-3">
          {footerNavigation.services.map((item) => (
            <li>
              <a href={item.href} class="text-base-500 hover:text-base-900 transition-colors duration-200">
                {item.name}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
    
    <!-- Copyright -->
    <div class="mt-12 pt-8 border-t border-base-200">
      <p class="text-sm text-base-500">
        Copyright © {currentYear} Kairos Advisory Group. All Rights Reserved. 
        We are an Advisory Group with 
        <a href="http://www.ippfa.com" class="underline hover:text-base-900" target="_blank" rel="noopener noreferrer">
          IPP Financial Advisers Pte Ltd
        </a>.
      </p>
    </div>
  </div>
</footer>
