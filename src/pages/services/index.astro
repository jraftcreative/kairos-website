---
import BaseLayout from '../../layouts/BaseLayout.astro'

const services = [
  {
    title: 'Financial Planning',
    description: 'Our comprehensive six-step financial planning process helps you understand your current financial position and create a roadmap to achieve your goals.',
    features: [
      'Comprehensive needs analysis',
      'Goal setting and prioritization',
      'Customized financial strategies',
      'Regular progress reviews'
    ],
    image: 'https://images.unsplash.com/photo-1554224155-8d04cb21cd6c?q=80&w=2070&auto=format&fit=crop',
    href: '/services/financial-planning'
  },
  {
    title: 'Investment Methodologies',
    description: 'Using our proprietary V.E.S.T analysis framework, we help you build and manage investment portfolios aligned with your risk tolerance and objectives.',
    features: [
      'Risk assessment and profiling',
      'Portfolio diversification',
      'Market analysis and insights',
      'Performance monitoring'
    ],
    image: 'https://images.unsplash.com/photo-1611974789855-9c2a0a7236a3?q=80&w=2070&auto=format&fit=crop',
    href: '/services/investment-methodologies'
  },
  {
    title: 'Insurance Selection',
    description: 'We analyze your protection needs and recommend best-in-class insurance solutions to safeguard you and your loved ones.',
    features: [
      'Life and health insurance',
      'Critical illness coverage',
      'Income protection',
      'Estate planning'
    ],
    image: 'https://images.unsplash.com/photo-1450101499163-c8848c66ca85?q=80&w=2070&auto=format&fit=crop',
    href: '/services/insurance-selection'
  },
  {
    title: 'Business Solutions',
    description: 'Comprehensive protection and planning solutions for businesses of all sizes, from key person insurance to succession planning.',
    features: [
      'Key person insurance',
      'Business continuity planning',
      'Employee benefits',
      'Buy-sell agreements'
    ],
    image: 'https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?q=80&w=2070&auto=format&fit=crop',
    href: '/services/business-solutions'
  }
]
---

<BaseLayout 
  title="Our Services | Kairos Advisory Group"
  description="Explore our comprehensive range of financial planning, investment, insurance, and business advisory services."
>
  <!-- Hero -->
  <section class="bg-white">
    <div class="mx-auto max-w-7xl px-6 md:px-12 py-16 lg:py-24">
      <div class="max-w-3xl">
        <p class="text-sm font-medium text-base-500 uppercase tracking-wider mb-4">Our Services</p>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-medium tracking-tight text-base-900">
          Comprehensive Financial Solutions
        </h1>
        <p class="text-xl text-base-500 mt-8 text-pretty">
          From personal financial planning to business advisory, we offer a full spectrum of 
          services tailored to your unique needs and goals.
        </p>
      </div>
    </div>
  </section>
  
  <!-- Services List -->
  <section class="bg-white">
    <div class="mx-auto max-w-7xl px-6 md:px-12 pb-16 lg:pb-24">
      <div class="space-y-16 lg:space-y-24">
        {services.map((service, index) => (
          <article class="grid lg:grid-cols-2 gap-8 lg:gap-16 items-center border-t border-base-200 pt-16">
            <div class:list={[index % 2 === 1 && 'lg:order-2']}>
              <img 
                src={service.image} 
                alt={service.title}
                loading="lazy"
                decoding="async"
                class="w-full aspect-[4/3] object-cover"
              />
            </div>
            
            <div class:list={[index % 2 === 1 && 'lg:order-1']}>
              <h2 class="text-2xl md:text-3xl font-medium text-base-900">
                {service.title}
              </h2>
              <p class="text-base text-base-500 mt-4">
                {service.description}
              </p>
              
              <ul class="mt-8 space-y-3">
                {service.features.map((feature) => (
                  <li class="flex items-center gap-3 text-base text-base-600">
                    <svg class="w-5 h-5 text-base-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                    </svg>
                    {feature}
                  </li>
                ))}
              </ul>
              
              <a 
                href={service.href}
                class="inline-flex items-center gap-2 text-base-900 font-medium mt-8 group"
              >
                <span>Learn more</span>
                <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                </svg>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
  
  <!-- CTA -->
  <section class="bg-base-50">
    <div class="mx-auto max-w-7xl px-6 md:px-12 py-16 lg:py-24">
      <div class="max-w-2xl mx-auto text-center">
        <h2 class="text-2xl md:text-3xl font-medium text-base-900">
          Not sure which service is right for you?
        </h2>
        <p class="text-base text-base-500 mt-4">
          Schedule a complimentary consultation and we'll help you identify the best solutions for your needs.
        </p>
        <a 
          href="/contact" 
          class="inline-flex items-center justify-center px-8 py-4 bg-base-900 text-white font-medium hover:bg-base-800 transition-colors duration-200 mt-8"
        >
          Schedule a Consultation
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
