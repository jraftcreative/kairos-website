---
import BaseLayout from '../layouts/BaseLayout.astro'

const contactInfo = [
  {
    title: 'Phone',
    value: '+65 6511 8888',
    href: 'tel:+6565118888',
    icon: 'phone'
  },
  {
    title: 'Email',
    value: 'info@kairosadvisory.sg',
    href: 'mailto:info@kairosadvisory.sg',
    icon: 'email'
  },
  {
    title: 'Office Hours',
    value: 'Mon - Fri: 9am - 6pm',
    href: null,
    icon: 'clock'
  }
]
---

<BaseLayout 
  title="Contact Us | Kairos Advisory Group"
  description="Get in touch with Kairos Advisory Group. Schedule a consultation or reach out to discuss your financial planning needs."
>
  <!-- Hero -->
  <section class="bg-white">
    <div class="mx-auto max-w-7xl px-6 md:px-12 py-16 lg:py-24">
      <div class="max-w-3xl">
        <p class="text-sm font-medium text-base-500 uppercase tracking-wider mb-4">Contact Us</p>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-medium tracking-tight text-base-900">
          Let's Start a Conversation
        </h1>
        <p class="text-xl text-base-500 mt-8 text-pretty">
          Ready to take control of your financial future? We're here to help. 
          Reach out to schedule a complimentary consultation.
        </p>
      </div>
    </div>
  </section>
  
  <!-- Contact Form & Info -->
  <section class="bg-white">
    <div class="mx-auto max-w-7xl px-6 md:px-12 pb-16 lg:pb-24">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-24">
        <!-- Contact Form -->
        <div class="bg-base-50 p-8 lg:p-12">
          <h2 class="text-xl font-medium text-base-900 mb-8">Send us a message</h2>
          
          <form action="#" method="POST" class="space-y-6">
            <div class="grid sm:grid-cols-2 gap-6">
              <div>
                <label for="firstName" class="block text-sm font-medium text-base-700 mb-2">
                  First Name *
                </label>
                <input 
                  type="text" 
                  id="firstName" 
                  name="firstName" 
                  required
                  class="w-full px-4 py-3 border border-base-200 bg-white focus:outline-none focus:ring-2 focus:ring-base-900 focus:border-transparent transition-shadow"
                />
              </div>
              <div>
                <label for="lastName" class="block text-sm font-medium text-base-700 mb-2">
                  Last Name *
                </label>
                <input 
                  type="text" 
                  id="lastName" 
                  name="lastName" 
                  required
                  class="w-full px-4 py-3 border border-base-200 bg-white focus:outline-none focus:ring-2 focus:ring-base-900 focus:border-transparent transition-shadow"
                />
              </div>
            </div>
            
            <div>
              <label for="email" class="block text-sm font-medium text-base-700 mb-2">
                Email Address *
              </label>
              <input 
                type="email" 
                id="email" 
                name="email" 
                required
                class="w-full px-4 py-3 border border-base-200 bg-white focus:outline-none focus:ring-2 focus:ring-base-900 focus:border-transparent transition-shadow"
              />
            </div>
            
            <div>
              <label for="phone" class="block text-sm font-medium text-base-700 mb-2">
                Phone Number
              </label>
              <input 
                type="tel" 
                id="phone" 
                name="phone"
                class="w-full px-4 py-3 border border-base-200 bg-white focus:outline-none focus:ring-2 focus:ring-base-900 focus:border-transparent transition-shadow"
              />
            </div>
            
            <div>
              <label for="interest" class="block text-sm font-medium text-base-700 mb-2">
                I'm interested in...
              </label>
              <select 
                id="interest" 
                name="interest"
                class="w-full px-4 py-3 border border-base-200 bg-white focus:outline-none focus:ring-2 focus:ring-base-900 focus:border-transparent transition-shadow"
              >
                <option value="">Select an option</option>
                <option value="financial-planning">Financial Planning</option>
                <option value="investment">Investment Methodologies</option>
                <option value="insurance">Insurance Selection</option>
                <option value="business">Business Solutions</option>
                <option value="other">Other</option>
              </select>
            </div>
            
            <div>
              <label for="message" class="block text-sm font-medium text-base-700 mb-2">
                Message *
              </label>
              <textarea 
                id="message" 
                name="message" 
                rows="4"
                required
                class="w-full px-4 py-3 border border-base-200 bg-white focus:outline-none focus:ring-2 focus:ring-base-900 focus:border-transparent transition-shadow resize-none"
                placeholder="Tell us about your financial goals or questions..."
              ></textarea>
            </div>
            
            <button 
              type="submit"
              class="w-full px-8 py-4 bg-base-900 text-white font-medium hover:bg-base-800 transition-colors duration-200"
            >
              Send Message
            </button>
          </form>
        </div>
        
        <!-- Contact Info -->
        <div class="lg:pt-12">
          <h2 class="text-xl font-medium text-base-900 mb-8">Contact Information</h2>
          
          <div class="space-y-8">
            {contactInfo.map((info) => (
              <div class="flex items-start gap-4">
                <div class="w-12 h-12 bg-base-100 flex items-center justify-center flex-shrink-0">
                  {info.icon === 'phone' && (
                    <svg class="w-6 h-6 text-base-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
                    </svg>
                  )}
                  {info.icon === 'email' && (
                    <svg class="w-6 h-6 text-base-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
                    </svg>
                  )}
                  {info.icon === 'clock' && (
                    <svg class="w-6 h-6 text-base-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                  )}
                </div>
                <div>
                  <p class="text-sm text-base-500">{info.title}</p>
                  {info.href ? (
                    <a href={info.href} class="text-base-900 font-medium hover:text-base-600 transition-colors">
                      {info.value}
                    </a>
                  ) : (
                    <p class="text-base-900 font-medium">{info.value}</p>
                  )}
                </div>
              </div>
            ))}
          </div>
          
          <!-- Office Location -->
          <div class="mt-12 pt-12 border-t border-base-200">
            <h3 class="text-lg font-medium text-base-900 mb-4">Our Office</h3>
            <p class="text-base text-base-500">
              Singapore Financial Centre<br />
              (Part of IPP Financial Advisers Pte Ltd)
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
