---
import BaseLayout from '../layouts/BaseLayout.astro'

const base = import.meta.env.BASE_URL

const steps = [
  {
    number: '01',
    title: 'Discovery',
    description: 'We begin by understanding your current financial situation, goals, and concerns through comprehensive discussions.'
  },
  {
    number: '02',
    title: 'Analysis',
    description: 'Our team analyzes your financial data to identify gaps, opportunities, and areas requiring attention.'
  },
  {
    number: '03',
    title: 'Planning',
    description: 'We develop customized strategies and recommendations tailored to your unique circumstances and objectives.'
  },
  {
    number: '04',
    title: 'Implementation',
    description: 'We help you execute the plan, selecting the best products and solutions to achieve your goals.'
  },
  {
    number: '05',
    title: 'Monitoring',
    description: 'Regular reviews ensure your plan remains on track and adapts to changes in your life and the market.'
  },
  {
    number: '06',
    title: 'Optimization',
    description: 'We continuously refine your strategy to maximize outcomes and respond to new opportunities.'
  }
]

const principles = [
  {
    title: 'Transparency',
    description: 'We believe in clear, honest communication about fees, risks, and recommendations.',
    icon: 'eye'
  },
  {
    title: 'Independence',
    description: 'Our advice is driven by your needs, not product quotas or commission targets.',
    icon: 'shield'
  },
  {
    title: 'Excellence',
    description: 'We continuously enhance our knowledge and skills to serve you better.',
    icon: 'star'
  }
]
---

<BaseLayout 
  title="Our Approach | Kairos Advisory Group"
  description="Learn about our systematic six-step financial planning process and the principles that guide our advisory services."
>
  <!-- Hero -->
  <section class="bg-white">
    <div class="mx-auto max-w-7xl px-6 md:px-12 py-16 lg:py-24">
      <div class="max-w-3xl">
        <p class="text-sm font-medium text-base-500 uppercase tracking-wider mb-4">Our Approach</p>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-medium tracking-tight text-base-900">
          A Systematic Path to Financial Success
        </h1>
        <p class="text-xl text-base-500 mt-8 text-pretty">
          Our proven six-step financial planning process ensures comprehensive, 
          personalized solutions that evolve with your life.
        </p>
      </div>
    </div>
  </section>
  
  <!-- Process Steps -->
  <section class="bg-white">
    <div class="mx-auto max-w-7xl px-6 md:px-12 pb-16 lg:pb-24">
      <div class="grid lg:grid-cols-3 gap-8">
        {steps.map((step) => (
          <div class="border-t border-base-200 pt-8">
            <span class="text-4xl font-medium text-base-200">{step.number}</span>
            <h3 class="text-xl font-medium text-base-900 mt-4">{step.title}</h3>
            <p class="text-base text-base-500 mt-4">{step.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
  
  <!-- Principles -->
  <section class="bg-base-900">
    <div class="mx-auto max-w-7xl px-6 md:px-12 py-16 lg:py-24">
      <div class="max-w-2xl mb-12">
        <h2 class="text-2xl md:text-3xl font-medium text-white">
          Guiding Principles
        </h2>
        <p class="text-base text-base-300 mt-4">
          These core principles shape every interaction and recommendation we make.
        </p>
      </div>
      
      <div class="grid md:grid-cols-3 gap-8">
        {principles.map((principle) => (
          <div class="bg-base-800 p-8">
            <div class="w-12 h-12 bg-base-700 flex items-center justify-center mb-6">
              {principle.icon === 'eye' && (
                <svg class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              )}
              {principle.icon === 'shield' && (
                <svg class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
                </svg>
              )}
              {principle.icon === 'star' && (
                <svg class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z" />
                </svg>
              )}
            </div>
            <h3 class="text-xl font-medium text-white">{principle.title}</h3>
            <p class="text-base text-base-300 mt-4">{principle.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
  
  <!-- CTA -->
  <section class="bg-white">
    <div class="mx-auto max-w-7xl px-6 md:px-12 py-16 lg:py-24">
      <div class="max-w-2xl mx-auto text-center">
        <h2 class="text-2xl md:text-3xl font-medium text-base-900">
          Ready to experience our approach?
        </h2>
        <p class="text-base text-base-500 mt-4">
          Schedule a complimentary discovery session to see how we can help you achieve your financial goals.
        </p>
        <a 
          href={`${base}contact/`}
          class="inline-flex items-center justify-center px-8 py-4 bg-base-900 text-white font-medium hover:bg-base-800 transition-colors duration-200 mt-8"
        >
          Get Started
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
