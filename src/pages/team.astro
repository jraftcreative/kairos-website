---
import BaseLayout from '../layouts/BaseLayout.astro'

const base = import.meta.env.BASE_URL

const team = [
  {
    name: 'David Lim',
    role: 'Managing Director',
    bio: 'With over 20 years of experience in financial advisory, David leads our team with a commitment to client excellence and professional integrity.',
    image: 'https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?q=80&w=400&auto=format&fit=crop'
  },
  {
    name: 'Sarah Chen',
    role: 'Senior Financial Consultant',
    bio: 'Sarah specializes in comprehensive financial planning for high-net-worth individuals and families, with expertise in estate planning.',
    image: 'https://images.unsplash.com/photo-1580489944761-15a19d654956?q=80&w=400&auto=format&fit=crop'
  },
  {
    name: 'Michael Tan',
    role: 'Investment Specialist',
    bio: 'Michael brings analytical rigor to investment planning, helping clients build diversified portfolios aligned with their goals.',
    image: 'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?q=80&w=400&auto=format&fit=crop'
  },
  {
    name: 'Rachel Wong',
    role: 'Insurance Specialist',
    bio: 'Rachel has helped hundreds of families secure comprehensive protection through tailored insurance solutions.',
    image: 'https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?q=80&w=400&auto=format&fit=crop'
  },
  {
    name: 'James Lee',
    role: 'Business Solutions Consultant',
    bio: 'James focuses on corporate advisory, helping businesses protect their key assets and plan for succession.',
    image: 'https://images.unsplash.com/photo-1519085360753-af0119f7cbe7?q=80&w=400&auto=format&fit=crop'
  },
  {
    name: 'Grace Ng',
    role: 'Financial Consultant',
    bio: 'Grace is passionate about helping young professionals start their financial journey with the right foundation.',
    image: 'https://images.unsplash.com/photo-1598550874175-4d0ef436c909?q=80&w=400&auto=format&fit=crop'
  }
]
---

<BaseLayout 
  title="Our Team | Kairos Advisory Group"
  description="Meet our team of experienced financial advisers dedicated to helping you achieve your financial goals."
>
  <!-- Hero -->
  <section class="bg-white">
    <div class="mx-auto max-w-7xl px-6 md:px-12 py-16 lg:py-24">
      <div class="max-w-3xl">
        <p class="text-sm font-medium text-base-500 uppercase tracking-wider mb-4">Our Team</p>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-medium tracking-tight text-base-900">
          Meet Our Financial Experts
        </h1>
        <p class="text-xl text-base-500 mt-8 text-pretty">
          Our network of professional advisers apply their market knowledge to create 
          comprehensive and customized plans for your wealth.
        </p>
      </div>
    </div>
  </section>
  
  <!-- Team Grid -->
  <section class="bg-white">
    <div class="mx-auto max-w-7xl px-6 md:px-12 pb-16 lg:pb-24">
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {team.map((member) => (
          <div class="group">
            <div class="overflow-hidden">
              <img 
                src={member.image} 
                alt={member.name}
                loading="lazy"
                decoding="async"
                class="w-full aspect-[3/4] object-cover object-top group-hover:scale-105 transition-transform duration-500"
              />
            </div>
            <div class="mt-6">
              <h3 class="text-xl font-medium text-base-900">{member.name}</h3>
              <p class="text-sm text-base-500 mt-1">{member.role}</p>
              <p class="text-base text-base-500 mt-4">{member.bio}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
  
  <!-- Join Team CTA -->
  <section class="bg-base-50">
    <div class="mx-auto max-w-7xl px-6 md:px-12 py-16 lg:py-24">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <h2 class="text-2xl md:text-3xl font-medium text-base-900">
            Join Our Team
          </h2>
          <p class="text-base text-base-500 mt-4">
            We're always looking for talented financial professionals who share our commitment 
            to client success and ethical practice. If you're passionate about helping others 
            achieve their financial goals, we'd love to hear from you.
          </p>
          <a 
            href={`${base}career/`}
            class="inline-flex items-center justify-center px-8 py-4 bg-base-900 text-white font-medium hover:bg-base-800 transition-colors duration-200 mt-8"
          >
            View Opportunities
          </a>
        </div>
        <div class="hidden lg:block">
          <img 
            src="https://images.unsplash.com/photo-1600880292089-90a7e086ee0c?q=80&w=800&auto=format&fit=crop"
            alt="Team collaboration"
            loading="lazy"
            decoding="async"
            class="w-full aspect-video object-cover"
          />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
