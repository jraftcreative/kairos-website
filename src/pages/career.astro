---
import BaseLayout from '../layouts/BaseLayout.astro'

const base = import.meta.env.BASE_URL

const benefits = [
  {
    title: 'Competitive Commission',
    description: 'Attractive commission structure with unlimited earning potential.'
  },
  {
    title: 'Training & Development',
    description: 'Comprehensive training programs and continuous professional development.'
  },
  {
    title: 'Supportive Culture',
    description: 'Collaborative environment with mentorship from experienced advisers.'
  },
  {
    title: 'Career Growth',
    description: 'Clear progression pathways to leadership and management roles.'
  }
]
---

<BaseLayout 
  title="Career | Kairos Advisory Group"
  description="Join our team of financial professionals. Explore career opportunities at Kairos Advisory Group."
>
  <!-- Hero -->
  <section class="bg-white">
    <div class="mx-auto max-w-7xl px-6 md:px-12 py-16 lg:py-24">
      <div class="max-w-3xl">
        <p class="text-sm font-medium text-base-500 uppercase tracking-wider mb-4">Career</p>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-medium tracking-tight text-base-900">
          Build Your Future With Us
        </h1>
        <p class="text-xl text-base-500 mt-8 text-pretty">
          Join a team of professionals committed to making a difference in people's financial lives. 
          We're always looking for talented individuals who share our values.
        </p>
      </div>
    </div>
  </section>
  
  <!-- Benefits -->
  <section class="bg-base-50">
    <div class="mx-auto max-w-7xl px-6 md:px-12 py-16 lg:py-24">
      <h2 class="text-2xl md:text-3xl font-medium text-base-900 mb-12">
        Why Join Kairos?
      </h2>
      
      <div class="grid md:grid-cols-2 gap-8">
        {benefits.map((benefit) => (
          <div class="bg-white p-8 border border-base-200">
            <h3 class="text-xl font-medium text-base-900">{benefit.title}</h3>
            <p class="text-base text-base-500 mt-4">{benefit.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
  
  <!-- CTA -->
  <section class="bg-base-900">
    <div class="mx-auto max-w-7xl px-6 md:px-12 py-16 lg:py-24">
      <div class="max-w-2xl">
        <h2 class="text-2xl md:text-3xl font-medium text-white">
          Interested in joining our team?
        </h2>
        <p class="text-base text-base-300 mt-4">
          Send us your resume and we'll be in touch to discuss opportunities.
        </p>
        <a 
          href={`${base}contact/`}
          class="inline-flex items-center justify-center px-8 py-4 bg-white text-base-900 font-medium hover:bg-base-100 transition-colors duration-200 mt-8"
        >
          Contact Us
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
